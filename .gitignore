# Ignore everything except bb folders and install script
/*
!/bbai
!/bbos
!/bbapps
!/install

# And their contents
!/bbai/**
!/bbos/**
!/bbapps/**

!/README.md
!/.gitignore
!/.gitmodules

# Replay episode download cache (regenerated by replay_training.py)
/bbapps/inference/replay_data/

# macOS artifacts
**/._*
**/.DS_Store
**/.AppleDouble
**/.LSOverride
**/.__afsvolume
**/.Spotlight-V100
**/.Trashes

# Legacy per-ID base calibration names; current robots use gitignored
# base/config.yaml.
config_*.yaml
